{
  "name": "doc-reader-ai-frontend",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "mock:pdfs": "python3 scripts/gen_mock_pdfs.py",
    "test": "mkdir -p .test-dist && tsc src/lib/sidebarDrag.ts --target ES2022 --module ES2022 --moduleResolution bundler --outDir .test-dist --skipLibCheck && for f in tests/*.mjs; do node --test \"$f\" || exit 1; done"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "katex": "^0.18.4",
    "pdfjs-dist": "5.4.296",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  }
}
